# ---------------------------
# Root .gitignore for MERN
# ---------------------------

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/

# --- Environment files ---
.env
.env.local
.env.development
.env.production
.env.test

# --- Logs ---
logs/
*.log
log.txt

# --- Runtime data ---
pids/
*.pid
*.seed
*.pid.lock

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- Backend specific ---
/backend/node_modules/
/backend/dist/
/backend/build/
/backend/.env

# --- Frontend specific ---
/frontend/node_modules/
/frontend/build/
/frontend/.env
/.parcel-cache
/.next
/.turbo
.cache
